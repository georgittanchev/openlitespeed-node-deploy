#!/usr/bin/env python3
"""
atomic-swap NEW LIVE

Exchange two directories in one atomic step with renameat2(RENAME_EXCHANGE),
so there is never a moment where LIVE does not exist. After the swap, NEW holds
the previous release (delete it, or keep it for a rollback: running the same
command again swaps them back).

Linux >= 3.15, glibc >= 2.28, both paths on the same filesystem. Works on
ext4, xfs, btrfs and tmpfs; some network/overlay filesystems return EINVAL.
"""
import ctypes
import os
import sys

AT_FDCWD = -100
RENAME_EXCHANGE = 2


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    new, live = sys.argv[1], sys.argv[2]
    for p in (new, live):
        if not os.path.isdir(p):
            print(f"atomic-swap: {p} is not a directory", file=sys.stderr)
            return 1
    libc = ctypes.CDLL(None, use_errno=True)
    try:
        renameat2 = libc.renameat2
    except AttributeError:
        print("atomic-swap: this libc has no renameat2 (glibc >= 2.28 needed)", file=sys.stderr)
        return 1
    if renameat2(AT_FDCWD, os.fsencode(new), AT_FDCWD, os.fsencode(live), RENAME_EXCHANGE) != 0:
        err = ctypes.get_errno()
        print(f"atomic-swap: {os.strerror(err)}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
